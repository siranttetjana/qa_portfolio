    {
      "name": "Update Pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Перевіряємо статус 200 OK\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Перевіряємо, що ім'я дійсно оновилося на \"Barsik Super\"\r\npm.test(\"Ім'я оновилося\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.name).to.eql(\"Barsik Super\");\r\n    pm.expect(jsonData.status).to.eql(\"sold\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": {{savedPetId}},\r\n  \"name\": \"Barsik Super\",\r\n  \"status\": \"sold\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
