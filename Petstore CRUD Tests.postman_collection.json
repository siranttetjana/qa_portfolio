  "item": [
    {
      "name": "Create Pet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Перевірка імені тварини\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.name).to.eql(\"Barsik\");\r\n});\r\n\r\npm.test(\"Статус код 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\nvar jsonData = pm.response.json();\r\npm.globals.set(\"savedPetId\", jsonData.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": 1234567,\r\n  \"name\": \"Barsik\",\r\n  \"status\": \"available\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://petstore.swagger.io/v2/pet",
          "protocol": "https",
          "host": [
            "petstore",
            "swagger",
            "io"
          ],
          "path": [
            "v2",
            "pet"
          ]
        }
      },
      "response": []
    },
